# ── Banco de Dados ──────────────────────────
DATABASE_URL=postgresql+asyncpg://financeai:senha@postgres:5432/financeai
POSTGRES_USER=financeai
POSTGRES_PASSWORD=senha
POSTGRES_DB=financeai

# ── Redis ────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Segredos da aplicação ────────────────────
SECRET_KEY=troque-por-64-bytes-aleatorios-hex
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Open Finance (DESLIGADO por padrão — custo de produção) ──
OPEN_FINANCE_ENABLED=false
OPEN_FINANCE_PROVIDER=pluggy     # pluggy | polp | belvo | celcoin

# Pluggy — https://dashboard.pluggy.ai
PLUGGY_CLIENT_ID=seu-client-id-aqui
PLUGGY_CLIENT_SECRET=seu-client-secret-aqui
PLUGGY_WEBHOOK_SECRET=webhook-secret-aleatorio

# Polp — https://www.polp.com.br
POLP_API_KEY=

# Belvo — https://belvo.com
BELVO_SECRET_ID=
BELVO_SECRET_PASSWORD=
BELVO_ENVIRONMENT=sandbox

# Celcoin — https://www.celcoin.com.br
CELCOIN_CLIENT_ID=
CELCOIN_CLIENT_SECRET=

# ── IA ────────────────────────────────────────
# Provedor ativo. OpenRouter (https://openrouter.ai) é o padrão do projeto;
# os demais ficam prontos para uso direto.
AI_PROVIDER=openrouter           # openrouter | anthropic | openai | gemini | groq
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
# Modelos por tarefa (nomes no formato do provedor ativo). O default abaixo é
# um modelo GRATUITO da OpenRouter (custo $0) — funciona só com uma API key,
# sem cartão de crédito. Ao adicionar crédito na conta, troque por um modelo
# pago para mais qualidade (ex.: anthropic/claude-sonnet-4.5 para chat/análise
# e anthropic/claude-haiku-4.5 para parse).
AI_CHAT_MODEL=openai/gpt-oss-20b:free
AI_PARSE_MODEL=openai/gpt-oss-20b:free
AI_ANALYSIS_MODEL=openai/gpt-oss-20b:free

# ── App ───────────────────────────────────────
ENVIRONMENT=development          # development | production
APP_NAME=FinanceAI
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:8001
SYNC_INTERVAL_HOURS=6            # frequência de sync automático com Pluggy

# ── Celery ───────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── Usuário admin inicial (seed) ─────────────
ADMIN_EMAIL=admin@financeai.app
ADMIN_PASSWORD=troque-esta-senha

# ── TZ ───────────────────────────────────────
TZ=America/Sao_Paulo
